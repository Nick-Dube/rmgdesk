# Copy to .env.local for local development, and set the same values in Amplify Hosting.
# Values come from the CDK stack outputs (npx cdk deploy prints them).
NEXT_PUBLIC_REGION=eu-west-2
NEXT_PUBLIC_USER_POOL_ID=eu-west-2_XXXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com
NEXT_PUBLIC_ENV_NAME=prod
